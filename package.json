{
  "name": "dsh-extra-folders",
  "version": "0.1.1",
  "description": "Attach extra writable folders to one workspace, granted per session, not profile-wide.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "multi-root",
    "folders",
    "writable",
    "sandbox",
    "permissions"
  ],
  "author": "kingOfSoySauce",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingOfSoySauce/dsh-extra-folders.git"
  },
  "homepage": "https://github.com/kingOfSoySauce/dsh-extra-folders#readme",
  "bugs": {
    "url": "https://github.com/kingOfSoySauce/dsh-extra-folders/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/approval.png",
    "assets/menu.png",
    "assets/dialog.png",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-alpha.3 <0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
